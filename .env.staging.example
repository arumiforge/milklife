#--------------------------------------------------------------------
# Contoh pengaturan lingkungan STAGING (K139).
#
# Staging = salinan web untuk mencoba perubahan (rombak tampilan,
# videotron, penskoran, dan lainnya) sebelum dipasang di produksi.
# Perilakunya dibuat sama dengan produksi (galat disembunyikan, CSS/JS
# kecil, HTTPS lewat Cloudflare Tunnel), tetapi semua yang bisa bentrok
# dengan produksi dipisah: folder, basis data, kunci, sesi, dan cadangan.
#
# Cara pakai di server (K182: staging dan produksi sama-sama Docker,
# boleh di VPS yang sama, masing-masing folder dan proyek compose sendiri):
#   1. Ambil kode ke folder TERPISAH dari produksi, misalnya
#      /srv/milklife-staging.
#   2. Salin berkas ini menjadi ".env" di folder itu, lalu ganti semua
#      nilai bertanda [ISI]. Berkas ".env" tidak boleh masuk git.
#      Salin juga docker/.env.example menjadi docker/.env dengan
#      COMPOSE_PROJECT_NAME=milklife-staging, SUBNET dan PORT_LOKAL yang
#      berbeda dari produksi, dan sandi basis data staging.
#   3. docker compose -f docker/compose.yaml up -d --build, lalu buat
#      kunci dengan "key:generate --show" (kunci baru, JANGAN salin dari
#      produksi) dan tempel di encryption.key, kemudian migrate --all,
#      sekolah:impor, data:awal, dan admin:buat lewat
#      "docker compose -f docker/compose.yaml exec app php spark ...",
#      sama seperti panduan pemasangan produksi.
#   4. Di dasbor Cloudflare, tunnel di host mengarahkan nama host staging
#      ke http://localhost:<PORT_LOKAL staging> (K184).
#
# Data: isi staging dengan pendaftaran karangan (nama dan NISN
# karangan). Bila terpaksa memakai salinan data produksi, staging WAJIB
# dikunci dengan Cloudflare Access (Zero Trust > Access > Applications)
# supaya hanya pemilik dan pengembang yang bisa membuka.
#
# Mesin pencari: staging tidak boleh terindeks. Di dasbor Cloudflare,
# Rules > Transform Rules > Modify Response Header, tambahkan kepala
# "X-Robots-Tag: noindex, nofollow" untuk nama host staging (tidak perlu
# mengubah kode). Cloudflare Access di atas juga sekaligus menutupnya.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# LINGKUNGAN
# Sama dengan produksi supaya yang dicoba di staging sama dengan yang
# nanti berjalan di produksi. Untuk melihat galat rinci sementara,
# ubah ke development lalu kembalikan lagi.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APLIKASI
#--------------------------------------------------------------------
# Alamat staging (K139)
app.baseURL = 'https://staging.mac2026.web.id/'
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'
app.defaultLocale = 'id'
# Sama dengan produksi; alasannya di bagian PRODUKSI ".env.example".
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# BASIS DATA
# Basis data dan pengguna MySQL SENDIRI, terpisah dari produksi, supaya
# percobaan di staging tidak pernah menyentuh data pendaftaran asli.
# Di Docker basis data dan penggunanya dibuat otomatis oleh container db
# staging dari docker/.env (DB_NAMA=milklife_staging,
# DB_PENGGUNA=milklife_staging, DB_SANDI sama dengan sandi di bawah).
#--------------------------------------------------------------------
database.default.hostname = db
database.default.database = milklife_staging
database.default.username = milklife_staging
# [ISI] sandi pengguna milklife_staging, langsung di ".env" staging
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Uji tidak dijalankan di staging. Dibiarkan menunjuk basis data uji
# tersendiri supaya "composer uji" yang tidak sengaja dijalankan tidak
# menghapus milklife_staging.
database.tests.hostname = 127.0.0.1
database.tests.database = milklife_staging_uji
database.tests.username = milklife_staging
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.port = 3306
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# KEAMANAN
#--------------------------------------------------------------------
# [ISI] buat dengan: php spark key:generate (berbeda dari produksi)
encryption.key =

cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'
# Kuki hanya berlaku untuk nama host masing-masing, jadi sesi admin
# staging dan produksi tidak saling menimpa walau dibuka di peramban yang
# sama. Jangan isi cookie.domain dengan domain induk.

#--------------------------------------------------------------------
# SESI
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null
session.expiration = 7200

#--------------------------------------------------------------------
# LOG
# 4 = galat dan peringatan, sama dengan produksi.
#--------------------------------------------------------------------
logger.threshold = 4

#--------------------------------------------------------------------
# KHUSUS APLIKASI INI
#--------------------------------------------------------------------
# CSS/JS dari "php spark aset:minify"; di Docker dibuat saat image dibangun.
aplikasi.minify = true

#--------------------------------------------------------------------
# CADANGAN
# Staging tidak perlu dicadangkan tiap malam. Bila "cadangan:buat"
# dijalankan, hasilnya ke folder sendiri, jangan ke folder cadangan
# produksi (cadangan lama di folder itu dihapus otomatis).
#--------------------------------------------------------------------
# Folder di dalam container; folder host-nya FOLDER_CADANGAN di
# docker/.env staging, misalnya /srv/cadangan/milklife-staging.
cadangan.folder = '/cadangan'
cadangan.simpanHari = 3
# Klien MySQL 8.4 sudah ada di image Docker.
cadangan.mysqldump = mysqldump

#--------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (K122)
# Pilih salah satu:
#   a. Pakai widget produksi: di dasbor Cloudflare (Turnstile > widget >
#      Settings > Hostname Management) tambahkan nama host staging, lalu
#      isi kunci rahasia yang sama langsung di ".env" staging.
#   b. Pakai kunci uji resmi Cloudflare yang selalu lolos (bukan rahasia,
#      tercantum di dokumentasi Turnstile), cocok untuk uji otomatis:
#        turnstile.kunciSitus   = 1x00000000000000000000AA
#        turnstile.kunciRahasia = 1x0000000000000000000000000000000AA
#   c. Kosongkan kunci rahasia: Turnstile mati di staging.
#--------------------------------------------------------------------
turnstile.kunciSitus = 0x4AAAAAAGFuKUT0k64YcOX5
# [ISI] langsung di ".env" staging, jangan di berkas ini
turnstile.kunciRahasia =
# Nama host staging (K139)
turnstile.namaHost = 'staging.mac2026.web.id'

#--------------------------------------------------------------------
# MONITORING (public/arumi.php)
# Sebaiknya kata sandi berbeda dari produksi. Buat hashnya:
#   php -r "echo password_hash('kata-sandi-baru', PASSWORD_BCRYPT), PHP_EOL;"
# lalu isi di ".env" staging:
# arumi.sandiHash = '$2y$12$...'
#--------------------------------------------------------------------
