#-------------------------
# Rahasia dan pengaturan lokal
#-------------------------
.env
.env.*
!.env.example

#-------------------------
# Composer
#-------------------------
/vendor/

#-------------------------
# Isi writable/ (hanya .htaccess dan index.html yang disimpan)
#-------------------------
/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

# Foto penanggung jawab (Tahap 4) dan unggahan lain di luar folder publik.
# Data pribadi: tidak pernah masuk git.
/writable/unggahan/

php_errors.log

#-------------------------
# Unggahan admin (gambar halaman depan, logo bank, berkas unduhan)
#-------------------------
/public/unggahan/

#-------------------------
# Versi kecil aset aplikasi, dibuat di server dengan `php spark aset:minify`.
# Pustaka di public/aset/vendor/ tetap menyimpan versi kecilnya sendiri.
#-------------------------
/public/aset/**/*.min.css
/public/aset/**/*.min.js
/public/aset/**/*.min.svg
!/public/aset/vendor/**

#-------------------------
# Hasil PHPUnit
#-------------------------
/build/
/phpunit.xml
/tests/coverage*
.phpunit.cache/
.phpunit.result.cache

#-------------------------
# Python (alat data)
#-------------------------
__pycache__/

#-------------------------
# Sistem operasi
#-------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

#-------------------------
# Penyunting
#-------------------------
.idea/
*.iml
.vscode/
*.sublime-workspace
*.sublime-project
