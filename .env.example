#--------------------------------------------------------------------
# Contoh pengaturan lingkungan.
# Salin menjadi ".env" lalu sesuaikan. Berkas ".env" tidak boleh masuk git.
#
# Nilai di bawah cocok untuk komputer pengembang dengan Laragon bawaan
# (Nginx + MySQL, folder proyek "milklife" sehingga alamatnya
# http://milklife.test).
# Baris bertanda [PRODUKSI] wajib diubah di server produksi, yang sejak
# K182 berjalan di Docker (docker/compose.yaml, panduan pemasangan
# produksi).
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# LINGKUNGAN
# development = galat tampil rinci. production = galat disembunyikan.
#--------------------------------------------------------------------
# [PRODUKSI] production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APLIKASI
#--------------------------------------------------------------------
# [PRODUKSI] alamat publik, diawali https:// dan diakhiri garis miring
app.baseURL = 'http://milklife.test/'
# Kosong supaya URL tanpa "index.php"
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'
app.defaultLocale = 'id'
# [PRODUKSI] true; alasannya di bagian PRODUKSI paling bawah
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# BASIS DATA
# Laragon bawaan: pengguna "root" tanpa sandi.
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = milklife
# [PRODUKSI] buat pengguna MySQL khusus, jangan pakai root. Di Docker:
# hostname db, nama basis data dan pengguna sama dengan docker/.env.
database.default.username = root
# [PRODUKSI] wajib diisi; di Docker sama dengan DB_SANDI di docker/.env
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Basis data terpisah untuk PHPUnit. Isinya dihapus setiap pengujian.
database.tests.hostname = 127.0.0.1
database.tests.database = milklife_uji
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.port = 3306
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# KEAMANAN
#--------------------------------------------------------------------
# Wajib diisi. Buat dengan: php spark key:generate
encryption.key =

# [PRODUKSI] true setelah HTTPS aktif
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# SESI
# Sesi admin disimpan sebagai berkas di writable/session.
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null
# Lama sesi admin dalam detik (7200 = 2 jam)
session.expiration = 7200

#--------------------------------------------------------------------
# LOG
# 9 = semua (pengembangan), 4 = galat dan peringatan (produksi)
#--------------------------------------------------------------------
# [PRODUKSI] 4
logger.threshold = 9

#--------------------------------------------------------------------
# KHUSUS APLIKASI INI (berlaku mulai Tahap 1)
#--------------------------------------------------------------------
# true = pakai CSS/JS hasil "php spark aset:minify" dan perkecil HTML
# [PRODUKSI] true
aplikasi.minify = false

#--------------------------------------------------------------------
# CADANGAN
# "php spark cadangan:buat" menulis satu zip berisi basis data dan
# semua unggahan. Di server produksi dijalankan tiap malam oleh cron
# host lewat docker compose exec (lihat panduan pemasangan produksi).
#--------------------------------------------------------------------
# [PRODUKSI] wajib diisi: folder yang sudah ada, di luar folder proyek.
# Di Docker selalu '/cadangan' (folder host FOLDER_CADANGAN di
# docker/.env). Di Windows misalnya 'D:\cadangan-milklife'.
cadangan.folder =
# Cadangan yang berumur sebanyak ini hari atau lebih dihapus otomatis.
cadangan.simpanHari = 14
# Di Docker cukup mysqldump (klien MySQL 8.4 ada di image). Di Laragon
# jalur lengkap mysqldump.exe, misalnya
# 'C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe'.
cadangan.mysqldump = mysqldump

#--------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (K122)
# Pemeriksaan "bukan robot" di kirim pendaftaran, Cek Pendaftaran, dan
# masuk admin. Bila salah satu kunci kosong, Turnstile MATI dan web
# berjalan tanpa pemeriksaan ini.
#
# Kunci situs di bawah publik (boleh ditulis di sini). Kunci rahasia
# TIDAK PERNAH ditulis di berkas ini: ambil dari dasbor Cloudflare
# (Turnstile > widget > Settings) dan isi langsung di ".env" server.
# Mematikan sementara: kosongkan turnstile.kunciRahasia di ".env" server.
#--------------------------------------------------------------------
turnstile.kunciSitus = 0x4AAAAAAGFuKUT0k64YcOX5
# [PRODUKSI] isi di ".env" server, jangan di berkas ini
turnstile.kunciRahasia =
# Nama host yang diizinkan, dipisah koma, tanpa https:// dan tanpa garis
# miring. Kosong = nama host dari app.baseURL.
# [PRODUKSI] alamat publik saja, tanpa localhost, misalnya
# turnstile.namaHost = 'daftar.contoh.sch.id'
turnstile.namaHost = 'milklife.test,localhost,127.0.0.1'

#--------------------------------------------------------------------
# MONITORING (public/arumi.php)
# Kata sandi halaman Monitoring disimpan sebagai hash bcrypt. Kosong =
# memakai hash bawaan di arumi.php. Untuk kata sandi lain, buat hashnya:
#   php -r "echo password_hash('kata-sandi-baru', PASSWORD_BCRYPT), PHP_EOL;"
# lalu isi di ".env" server (bukan di berkas ini):
# arumi.sandiHash = '$2y$12$...'
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# PRODUKSI
# Isian untuk server (K31, K182): server web di container app tetap
# HTTP, HTTPS ditangani Cloudflare lewat Cloudflare Tunnel, dan
# "cloudflared" di host meneruskan ke 127.0.0.1:PORT_LOKAL, yang oleh
# Docker diteruskan dari gateway jaringan compose (K184).
#
# Cara pakai: ganti nilai baris bertanda [PRODUKSI] di atas dengan nilai
# di bawah (tanpa tanda "#" di depannya). Setiap kunci cukup ditulis
# sekali di ".env". Rahasia (sandi basis data, encryption.key) diisi
# langsung di ".env" server dan tidak pernah ditulis di berkas ini.
#--------------------------------------------------------------------
# Galat tampil sebagai halaman ramah tanpa rincian teknis.
# CI_ENVIRONMENT = production
#
# Alamat publik dari Cloudflare, diawali https:// dan diakhiri "/".
# app.baseURL = 'https://alamat-pendaftaran.contoh/'
#
# true, dan tidak menimbulkan pengalihan berulang di balik Tunnel.
# Alasan: server web memang menerima HTTP dari cloudflared, tetapi
# CodeIgniter 4.7 (IncomingRequest::isSecure()) menganggap permintaan
# sudah HTTPS bila datang dari alamat di App::$proxyIPs (127.0.0.1, ::1,
# dan subnet jaringan Docker dari MILKLIFE_SUBNET_PROXY, tempat
# cloudflared masuk) dan membawa kepala "X-Forwarded-Proto: https" yang selalu
# dikirim Cloudflare. Yang membuka server langsung lewat HTTP dari
# alamat lain dialihkan ke https://.
# Syarat: cloudflared host diarahkan ke http://localhost:PORT_LOKAL, atau
# container cloudflared proyek ini ke http://app:8080 (atau ke Nginx di
# komputer itu sendiri pada Laragon). Bila
# halaman terus memuat ulang, periksa SUBNET di docker/.env; sementara
# itu boleh kembalikan ke false, karena Cloudflare tetap memaksa HTTPS
# bila "Always Use HTTPS" di dasbor Cloudflare dinyalakan.
# app.forceGlobalSecureRequests = true
#
# Kuki sesi dan CSRF hanya dikirim lewat HTTPS, tidak terbaca JavaScript.
# cookie.secure = true
# cookie.httponly = true
# cookie.samesite = 'Lax'
#
# Container basis data di jaringan compose (K182).
# database.default.hostname = db
#
# Pengguna MySQL khusus aplikasi ini; sandinya diisi di ".env" server.
# database.default.username = milklife
#
# Folder cadangan di dalam container app (K182).
# cadangan.folder = '/cadangan'
#
# Log galat dan peringatan saja.
# logger.threshold = 4
#
# CSS/JS kecil dari "php spark aset:minify" dan HTML diperkecil.
# aplikasi.minify = true
