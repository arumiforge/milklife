#--------------------------------------------------------------------
# Contoh pengaturan lingkungan.
# Salin menjadi ".env" lalu sesuaikan. Berkas ".env" tidak boleh masuk git.
#
# Nilai di bawah cocok untuk Laragon bawaan (Nginx + MySQL, folder
# proyek "milklife" sehingga alamatnya http://milklife.test).
# Baris bertanda [PRODUKSI] wajib diubah di komputer produksi.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# LINGKUNGAN
# development = galat tampil rinci. production = galat disembunyikan.
#--------------------------------------------------------------------
# [PRODUKSI] production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APLIKASI
#--------------------------------------------------------------------
# [PRODUKSI] alamat publik, diawali https:// dan diakhiri garis miring
app.baseURL = 'http://milklife.test/'
# Kosong supaya URL tanpa "index.php"
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'
app.defaultLocale = 'id'
# [PRODUKSI] true; alasannya di bagian PRODUKSI paling bawah
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# BASIS DATA
# Laragon bawaan: pengguna "root" tanpa sandi.
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = milklife
# [PRODUKSI] buat pengguna MySQL khusus, jangan pakai root
database.default.username = root
# [PRODUKSI] wajib diisi
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Basis data terpisah untuk PHPUnit. Isinya dihapus setiap pengujian.
database.tests.hostname = 127.0.0.1
database.tests.database = milklife_uji
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.port = 3306
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# KEAMANAN
#--------------------------------------------------------------------
# Wajib diisi. Buat dengan: php spark key:generate
encryption.key =

# [PRODUKSI] true setelah HTTPS aktif
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# SESI
# Sesi admin disimpan sebagai berkas di writable/session.
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null
# Lama sesi admin dalam detik (7200 = 2 jam)
session.expiration = 7200

#--------------------------------------------------------------------
# LOG
# 9 = semua (pengembangan), 4 = galat dan peringatan (produksi)
#--------------------------------------------------------------------
# [PRODUKSI] 4
logger.threshold = 9

#--------------------------------------------------------------------
# KHUSUS APLIKASI INI (berlaku mulai Tahap 1)
#--------------------------------------------------------------------
# true = pakai CSS/JS hasil "php spark aset:minify" dan perkecil HTML
# [PRODUKSI] true
aplikasi.minify = false

#--------------------------------------------------------------------
# PRODUKSI
# Isian untuk komputer server (K31, asumsi 3 rencana Tahap 7): Nginx
# Laragon tetap HTTP, HTTPS ditangani Cloudflare lewat Cloudflare
# Tunnel, dan "cloudflared" berjalan di komputer yang sama.
#
# Cara pakai: ganti nilai baris bertanda [PRODUKSI] di atas dengan nilai
# di bawah (tanpa tanda "#" di depannya). Setiap kunci cukup ditulis
# sekali di ".env". Rahasia (sandi basis data, encryption.key) diisi
# langsung di ".env" server dan tidak pernah ditulis di berkas ini.
#--------------------------------------------------------------------
# Galat tampil sebagai halaman ramah tanpa rincian teknis.
# CI_ENVIRONMENT = production
#
# Alamat publik dari Cloudflare, diawali https:// dan diakhiri "/".
# app.baseURL = 'https://alamat-pendaftaran.contoh/'
#
# true, dan tidak menimbulkan pengalihan berulang di balik Tunnel.
# Alasan: Nginx memang menerima HTTP dari cloudflared, tetapi CodeIgniter
# 4.7 (IncomingRequest::isSecure()) menganggap permintaan sudah HTTPS
# bila datang dari alamat di App::$proxyIPs (127.0.0.1 dan ::1, yaitu
# cloudflared di komputer ini) dan membawa kepala
# "X-Forwarded-Proto: https" yang selalu dikirim Cloudflare. Nginx
# meneruskan kepala itu ke PHP tanpa pengaturan tambahan. Yang membuka
# server langsung lewat HTTP dari alamat lain (misalnya
# http://192.168.x.x dari jaringan kantor) dialihkan ke https://.
# Syarat: cloudflared diarahkan ke Nginx di komputer ini sendiri
# (http://localhost atau http://127.0.0.1), bukan ke alamat jaringan
# lokal server. Bila syarat ini tidak bisa dipenuhi dan halaman terus
# memuat ulang, kembalikan ke false; Cloudflare tetap memaksa HTTPS bila
# "Always Use HTTPS" di dasbor Cloudflare dinyalakan.
# app.forceGlobalSecureRequests = true
#
# Kuki sesi dan CSRF hanya dikirim lewat HTTPS, tidak terbaca JavaScript.
# cookie.secure = true
# cookie.httponly = true
# cookie.samesite = 'Lax'
#
# Pengguna MySQL khusus aplikasi ini; sandinya diisi di ".env" server.
# database.default.username = milklife
#
# Log galat dan peringatan saja.
# logger.threshold = 4
#
# CSS/JS kecil dari "php spark aset:minify" dan HTML diperkecil.
# aplikasi.minify = true
