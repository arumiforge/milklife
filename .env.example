#--------------------------------------------------------------------
# Contoh pengaturan lingkungan.
# Salin menjadi ".env" lalu sesuaikan. Berkas ".env" tidak boleh masuk git.
#
# Nilai di bawah cocok untuk Laragon bawaan (Nginx + MySQL, folder
# proyek "milklife" sehingga alamatnya http://milklife.test).
# Baris bertanda [PRODUKSI] wajib diubah di komputer produksi.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# LINGKUNGAN
# development = galat tampil rinci. production = galat disembunyikan.
#--------------------------------------------------------------------
# [PRODUKSI] production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APLIKASI
#--------------------------------------------------------------------
# [PRODUKSI] alamat publik, diawali https:// dan diakhiri garis miring
app.baseURL = 'http://milklife.test/'
# Kosong supaya URL tanpa "index.php"
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'
app.defaultLocale = 'id'
# [PRODUKSI] true setelah HTTPS aktif
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# BASIS DATA
# Laragon bawaan: pengguna "root" tanpa sandi.
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = milklife
# [PRODUKSI] buat pengguna MySQL khusus, jangan pakai root
database.default.username = root
# [PRODUKSI] wajib diisi
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Basis data terpisah untuk PHPUnit. Isinya dihapus setiap pengujian.
database.tests.hostname = 127.0.0.1
database.tests.database = milklife_uji
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.port = 3306
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# KEAMANAN
#--------------------------------------------------------------------
# Wajib diisi. Buat dengan: php spark key:generate
encryption.key =

# [PRODUKSI] true setelah HTTPS aktif
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# SESI
# Sesi admin disimpan sebagai berkas di writable/session.
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null
# Lama sesi admin dalam detik (7200 = 2 jam)
session.expiration = 7200

#--------------------------------------------------------------------
# LOG
# 9 = semua (pengembangan), 4 = galat dan peringatan (produksi)
#--------------------------------------------------------------------
# [PRODUKSI] 4
logger.threshold = 9

#--------------------------------------------------------------------
# KHUSUS APLIKASI INI (berlaku mulai Tahap 1)
#--------------------------------------------------------------------
# true = pakai CSS/JS hasil "php spark aset:minify" dan perkecil HTML
# [PRODUKSI] true
aplikasi.minify = false
