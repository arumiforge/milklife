#--------------------------------------------------------------------
# Pengaturan Docker Compose MilkLife untuk SATU lingkungan (K182).
#
# Salin berkas ini menjadi docker/.env di folder kode lingkungan itu,
# lalu ganti semua nilai bertanda [ISI]. docker/.env berisi rahasia:
# tidak masuk git, izin berkas 600 (chmod 600 docker/.env).
#
# Berkas ini berbeda dari .env aplikasi di folder kode (salinan
# .env.example atau .env.staging.example). Nilai DB_NAMA, DB_PENGGUNA,
# dan DB_SANDI di sini membuat basis data di container db; nilai yang
# SAMA ditulis juga di .env aplikasi (database.default.database,
# .username, .password, dengan database.default.hostname = db).
#--------------------------------------------------------------------

# Nama proyek compose. Harus berbeda untuk setiap lingkungan di server
# yang sama, misalnya milklife-produksi dan milklife-staging. Nama ini
# menjadi awalan container, volume, dan jaringan.
COMPOSE_PROJECT_NAME=milklife-produksi

# Rentang alamat jaringan internal lingkungan ini. Harus tidak bentrok
# dengan jaringan Docker lain di server (cek: docker network inspect
# $(docker network ls -q) | grep Subnet). Contoh: produksi 10.201.0.0/24,
# staging 10.201.1.0/24.
SUBNET=10.201.0.0/24

# Basis data MySQL 8.4 di container db. [ISI] sandi panjang buatan
# sendiri, huruf dan angka saja, berbeda antara staging dan produksi.
# Basis data dan pengguna dibuat sekali saat volume data MySQL masih
# kosong; mengubah nilai ini setelahnya tidak mengganti sandi yang ada.
DB_NAMA=milklife
DB_PENGGUNA=milklife
DB_SANDI=[ISI]
DB_SANDI_ROOT=[ISI]

# Folder cadangan di host, di luar folder kode, sudah dibuat dan dimiliki
# uid 33 (www-data di container): sudo chown 33:33 <folder>
FOLDER_CADANGAN=/srv/cadangan/milklife-produksi

# Token Cloudflare Tunnel lingkungan ini (dasbor Cloudflare > Zero Trust >
# Networks > Tunnels > tunnel > perintah pemasangan Docker, bagian
# setelah --token). Tunnel staging dan produksi terpisah.
TUNNEL_TOKEN=[ISI]
